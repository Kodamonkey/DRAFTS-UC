# Copy to .env and adjust. docker-compose reads it automatically.
#
# Directory on the host holding the .fits / .fil files to process. Mounted
# read-only at /app/Data/raw inside the container. Compose refuses to start
# without it rather than inventing a path.
DRAFTS_DATA_DIR=./Data/raw

# Thread limits. 0 lets the pipeline size them from the detected hardware.
OMP_NUM_THREADS=0
MKL_NUM_THREADS=0
NUMBA_NUM_THREADS=0
